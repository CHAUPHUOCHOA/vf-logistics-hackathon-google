# VF Logistics Fraud Detection — Google Cloud

# Your GCP project ID
PROJECT_ID=your-project-id

# Vertex AI location. Must be `global` — Gemini 3.5 Flash is not served
# from regional endpoints (us-central1 / asia-southeast1 return 404).
LOCATION=global

# Port gunicorn binds to. Cloud Run sets this automatically.
PORT=8080

# --- Roadmap only: not read by the current code path ---
# FIRESTORE_DATABASE=(default)
# BQ_DATASET=fraud_detection
# PUBSUB_TOPIC=shipment-events
